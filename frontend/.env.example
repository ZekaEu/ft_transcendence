# Development Mode - Use mock API (no backend required)
# Set to 'true' to use mock API with localStorage, 'false' to use real backend
VITE_USE_MOCK_API=true

# API Configuration
VITE_API_BASE_URL=http://localhost:5000/api

# OAuth Configuration
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GITHUB_CLIENT_ID=your_github_client_id_here
VITE_42_CLIENT_ID=your_42_client_id_here

# Socket.io Configuration
VITE_SOCKET_URL=http://localhost:5000

# Credentials for mock users (only used if VITE_USE_MOCK_API=true)
MOCK_USER_1_USERNAME=mockuser1
MOCK_USER_1_PASSWORD=password123
MOCK_USER_1_EMAIL=mockuser1@example.com