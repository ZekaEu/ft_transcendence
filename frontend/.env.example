# ─────────────────────────────────────────
# Modo de Desenvolvimento
# ─────────────────────────────────────────
# 'true' = usa mock API com localStorage (sem backend)
# 'false' = usa backend real
VITE_USE_MOCK_API=false

# ─────────────────────────────────────────
# API / Socket
# ─────────────────────────────────────────
VITE_API_BASE_URL=https://localhost:8443/api
VITE_SOCKET_URL=https://localhost:8443