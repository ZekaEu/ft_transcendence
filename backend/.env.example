# ─────────────────────────────────────────
# Flask
# ─────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-super-secret-key

# ─────────────────────────────────────────
# Database
# ─────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=triviadb
DB_USER=triviauser
DB_PASSWORD=triviapass

# ─────────────────────────────────────────
# JWT
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# ─────────────────────────────────────────
# OAuth 42
# https://profile.intra.42.fr/oauth/applications
# ─────────────────────────────────────────
OAUTH_42_CLIENT_ID=your_42_client_id
OAUTH_42_CLIENT_SECRET=your_42_client_secret
OAUTH_42_REDIRECT_URI=https://localhost:8443/api/auth/oauth/42/callback

# ─────────────────────────────────────────
# OAuth Google
# https://console.cloud.google.com/apis/credentials
# ─────────────────────────────────────────
OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret
OAUTH_GOOGLE_REDIRECT_URI=https://localhost:8443/api/auth/oauth/google/callback

# ─────────────────────────────────────────
# Frontend URL
# ─────────────────────────────────────────
FRONTEND_URL=https://localhost:8443
